// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum subscription_status {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

enum subscription_interval {
  none
  month
  year
}

enum project_status {
  open
  completed
}

enum reward_type {
  fixed        // 金額を指定
  negotiable   // 見積もり希望（相談して決める）
}

enum request_status {
  open
  completed
}

enum match_status {
  pending
  active
  rejected
  cancelled
}

enum article_status {
  draft
  published
  archived
}

enum review_target_role {
  contractor
  sales
}

enum interview_section_key {
  company_intro
  work_style
}

enum interview_block_type {
  section_title
  catch_copy
  heading
  text
  image
}

model users {
  id               String   @id @db.Uuid
  email            String?
  isActive         Boolean
  isAdmin          Boolean
  stripeCustomerId String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  userSubscription          user_subscriptions?
  userSubscriptionHistories user_subscription_histories[]
  company                   companies?

  salesProjects      projects[]
  contractorRequests requests[]

  salesMatches      matches[] @relation("salesMatches")
  contractorMatches matches[] @relation("contractorMatches")

  createdInterviewArticles company_interview_articles[] @relation("createdInterviewArticles")
  updatedInterviewArticles company_interview_articles[] @relation("updatedInterviewArticles")

}

  // ▼ リレーションの見方メモ
  // email String? → 普通のカラム。文字列 or null。
  // company companies? → companiesモデルとのリレーション。1件 or null。
  // salesProjects projects[] → projectsモデルとのリレーション。複数件。


model user_subscriptions {
  id                   BigInt              @id @default(autoincrement())
  userId               String              @unique @db.Uuid
  planId               BigInt
  status               subscription_status
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean
  stripeSubscriptionId String?             @unique
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at")

  user users              @relation(fields: [userId], references: [id])
  plan subscription_plans @relation(fields: [planId], references: [id])
}

model user_subscription_histories {
  id                   BigInt              @id @default(autoincrement())
  userId               String              @db.Uuid
  planId               BigInt?
  status               subscription_status
  stripeSubscriptionId String?
  eventType            String?
  periodStart          DateTime?
  periodEnd            DateTime?
  rawPayload           String?
  createdAt            DateTime            @default(now()) @map("created_at")

  user users               @relation(fields: [userId], references: [id])
  plan subscription_plans? @relation(fields: [planId], references: [id])

  @@index([userId, createdAt])
}

model subscription_plans {
  id                        BigInt                @id @default(autoincrement())
  code                      String                @unique
  name                      String
  priceYen                  Int
  interval                  subscription_interval
  stripeProductId           String?
  stripePriceId             String?
  postLimitPerMonth         Int?
  canUseProfile             Boolean
  isActive                  Boolean
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @default(now()) @updatedAt @map("updated_at")

  userSubscriptions         user_subscriptions[]
  userSubscriptionHistories user_subscription_histories[]
}

model stripe_webhook_events {
  id            BigInt    @id @default(autoincrement())
  stripeEventId String    @unique
  type          String
  payload       String
  processed     Boolean
  processedAt   DateTime?
  createdAt     DateTime  @default(now()) @map("created_at")
}

model companies {
  id                 BigInt   @id @default(autoincrement())
  userId             String   @unique @db.Uuid
  name               String
  prefectureId       Int
  city               String?
  address            String?
  representativeName String?
  employeeCount      Int?
  websiteUrl         String?
  description        String?
  logoImageUrl       String?

  contactPhone       String?
  contactEmail       String?
  contactLineId      String?
  contactNote        String?

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  user             users                       @relation(fields: [userId], references: [id])
  prefecture       prefectures                 @relation(fields: [prefectureId], references: [id])
  interviewArticle company_interview_articles?

  reviewsWritten  reviews[] @relation("reviewsAsReviewer")
  reviewsReceived reviews[] @relation("reviewsAsReviewee")

}

model projects {
  id                   BigInt    @id @default(autoincrement())
  prefectureId         Int
  city                 String?
  title                String
  summary              String?
  note                 String?
  workStartDate        DateTime? @db.Date
  workEndDate          DateTime? @db.Date
  rewardYen            Int?
  rewardType           reward_type @default(fixed)
  paymentCycle         String?
  salesUserId          String    @db.Uuid
  status               project_status
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  prefecture prefectures @relation(fields: [prefectureId], references: [id])
  salesUser  users       @relation(fields: [salesUserId], references: [id])
  matches    matches[]
}

model requests {
  id                   BigInt    @id @default(autoincrement())
  city                 String?
  title                String
  summary              String?
  note                 String?
  availableStartDate   DateTime? @db.Date
  availableEndDate     DateTime? @db.Date
  rewardMinYen         Int?
  rewardType           reward_type @default(fixed)
  paymentCycle         String?
  contractorUserId     String    @db.Uuid
  status               request_status
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  prefectures    prefectures[] @relation("RequestPrefectures")
  contractorUser users       @relation(fields: [contractorUserId], references: [id])
  match          matches?
}

model prefectures {
  id           Int    @id
  name         String
  displayOrder Int

  companies companies[]
  projects  projects[]
  requests requests[] @relation("RequestPrefectures")
}

model application_details {
  id        BigInt   @id @default(autoincrement())
  matchId   BigInt   @unique
  message   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  match matches @relation(fields: [matchId], references: [id])
}

model matches {
  id               BigInt       @id @default(autoincrement())
  projectId        BigInt?
  requestId        BigInt?      @unique
  salesUserId      String       @db.Uuid
  contractorUserId String       @db.Uuid
  status           match_status
  salesSeenAt      DateTime?    @map("sales_seen_at")       // 販売店側がこのマッチのカードを開いた時刻（未読=null）
  contractorSeenAt DateTime?    @map("contractor_seen_at")  // 工事店側がこのマッチのカードを開いた時刻（未読=null）
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")

  project            projects?            @relation(fields: [projectId], references: [id])
  request            requests?            @relation(fields: [requestId], references: [id])
  salesUser          users                @relation("salesMatches", fields: [salesUserId], references: [id])
  contractorUser     users                @relation("contractorMatches", fields: [contractorUserId], references: [id])
  applicationDetail  application_details?
  reviews            reviews[]
}


model reviews {
  id                BigInt             @id @default(autoincrement())
  matchId           BigInt
  reviewerCompanyId BigInt             // レビューを書いた企業
  revieweeCompanyId BigInt             // 評価される企業
  targetRole        review_target_role // 評価される企業がこのマッチで担った役割
  item1Rating       Int
  item2Rating       Int
  item3Rating       Int
  item4Rating       Int
  item5Rating       Int
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at")

  match           matches   @relation(fields: [matchId], references: [id])
  reviewerCompany companies @relation("reviewsAsReviewer", fields: [reviewerCompanyId], references: [id])
  revieweeCompany companies @relation("reviewsAsReviewee", fields: [revieweeCompanyId], references: [id])

  @@unique([matchId, reviewerCompanyId])
  @@index([revieweeCompanyId, targetRole])
}

model company_interview_articles {
  id          BigInt         @id @default(autoincrement())
  companyId   BigInt         @unique
  title       String
  introText   String?
  youtubeUrl  String?   
  status      article_status
  publishedAt DateTime?
  createdBy   String         @db.Uuid
  updatedBy   String         @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")

  company       companies                  @relation(fields: [companyId], references: [id])
  createdByUser users                      @relation("createdInterviewArticles", fields: [createdBy], references: [id])
  updatedByUser users                      @relation("updatedInterviewArticles", fields: [updatedBy], references: [id])
  blocks        company_interview_blocks[]
}

model company_interview_blocks {
  id           BigInt                @id @default(autoincrement())
  articleId    BigInt
  sectionKey   interview_section_key
  blockType    interview_block_type
  textContent  String?
  imageUrl     String?
  imageAlt     String?
  displayOrder Int
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at")

  article company_interview_articles @relation(fields: [articleId], references: [id])

  @@index([articleId, sectionKey, displayOrder])
}
